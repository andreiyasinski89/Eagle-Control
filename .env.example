# Database
DATABASE_URL="postgresql://meetowl:meetowl@localhost:5432/meetowl"

# App
APP_URL="http://localhost:3000"

# Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET=""
# Public address of the app (https://app.example.com). Required when self-hosting: without it Auth.js refuses every request (UntrustedHost).
AUTH_URL=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mail: RESEND_API_KEY (a domain you own), or SMTP: Mailpit locally, or a real mailbox. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>, MAIL_FROM="MeetOwl <you@gmail.com>".
MAIL_FROM="MeetOwl <noreply@meetowl.local>"
RESEND_API_KEY=""
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
# SMTP_SECURE: TLS from the first byte. Leave empty: on for port 465, STARTTLS for 587.
SMTP_SECURE=""
# Sign-in e-mails the whole installation may send per day (Gmail allows about 500)
MAIL_DAILY_LIMIT=300

# Comma-separated addresses whose owned workspaces get the Pro plan without Stripe (yours, as the administrator)
PRO_OWNER_EMAILS=""

# Who is responsible for the service, shown in the privacy policy and terms (draft texts: have a lawyer review them)
LEGAL_OPERATOR_NAME=""
LEGAL_CONTACT_EMAIL=""

# Storage (S3-compatible; MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="meetowl"
S3_ACCESS_KEY="meetowl"
S3_SECRET_KEY="meetowl-secret"

# Encryption key for integration secrets, 32 bytes base64 (openssl rand -base64 32). Required once an integration is connected.
SECRETS_KEY=""

# Background jobs: "inline" runs jobs in-process (dev/tests); "inngest" hands them to Inngest.
JOBS_MODE="inline"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Realtime: "sse" (single process, local dev) or "liveblocks" (production)
REALTIME_PROVIDER="sse"
LIVEBLOCKS_SECRET_KEY=""

# Integrations (Pro)
GOOGLE_CAL_CLIENT_ID=""
GOOGLE_CAL_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# How many proxies in front of the app add to X-Forwarded-For (1 = one load balancer, e.g. Vercel). Used for rate limits.
TRUSTED_PROXY_HOPS=1

# Without Inngest: a secret that lets your scheduler call /api/jobs/<job> (at least 16 characters; empty = disabled)
CRON_SECRET=""

# Days a requested account deletion can still be cancelled (0 = erase as soon as it is confirmed)
ACCOUNT_DELETION_GRACE_DAYS=7

# Public demo: shows an "Open the demo" button on the sign-in page that signs anyone in to a shared sample workspace, and resets it daily. Never on a real installation.
DEMO_MODE="false"

# Billing (Stripe): secret key, webhook signing secret, price id of the Pro plan
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""

# AI (Anthropic Claude). Without a key, development uses canned answers; production refuses AI calls.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
