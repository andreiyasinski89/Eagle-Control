generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
  CLIENT
}

/// How much of the CRM a member with CRM access sees: their own people, their team's, or everyone.
enum CrmScope {
  OWN
  TEAM
  ALL
}

/// What a share lets the person do with a contact or a group of contacts.
enum ShareLevel {
  VIEW
  EDIT
}

enum NodeType {
  PROJECT
  EPIC
  SPRINT
  TASK
  SUBTASK
  DOCUMENT
  EVENT
  COMPANY
  CONTACT
  DEAL
}

enum NodeStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum ProgressMode {
  MANUAL
  AUTO
}

enum Health {
  GREEN
  YELLOW
  RED
}

enum LinkKind {
  BLOCKS
  RELATES
  ATTACHED
  DEAL_PROJECT
}

enum LifecycleStage {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
}

/// Where a person is on the way from "heard of us" to "a client or a partner". The funnel of network marketing.
enum PersonStage {
  NEW
  FIRST_CONTACT
  WARMING
  PRESENTATION
  DECIDING
  CLIENT
  PARTNER
  DECLINED
  NO_REPLY
}

/// How close the person is: close friends and family are hot, acquaintances warm, people from the networks cold.
enum Temperature {
  HOT
  WARM
  COLD
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  MESSAGE
}

enum ReminderChannel {
  IN_APP
  EMAIL
}

enum EstimationUnit {
  HOURS
  STORY_POINTS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum IntegrationKind {
  GOOGLE_CALENDAR
  GMAIL
  SLACK
  GITHUB
  TELEGRAM
  WEBHOOK
}

// ───────────────────────── Auth.js ─────────────────────────

model User {
  notes               Note[]
  personalGoals       PersonalGoal[]
  onboardingStates    OnboardingState[]
  id                  String            @id @default(cuid())
  /// The full display name, kept as first + last name when those are given (everything that shows a person reads this).
  name                String?
  firstName           String?
  lastName            String?
  phone               String?
  /// The Telegram user name without the @ (a link is made from it).
  telegram            String?
  email               String            @unique
  emailVerified       DateTime?
  avatar              String?
  image               String? // Auth.js OAuth avatar; `avatar` is user-chosen
  timezone            String            @default("UTC")
  locale              String            @default("en")
  skills              String[]
  createdAt           DateTime          @default(now())
  /// Set when the account was erased; the row stays as an anonymous "Deleted user" so work they authored keeps its structure.
  deletedAt           DateTime?
  /// Set while a deletion is scheduled; the account is erased once the grace period has passed.
  deletionRequestedAt DateTime?
  deletionOptions     Json?
  /**
   * When this person first signed in after agreeing to the terms and privacy policy.
   */
  termsAcceptedAt     DateTime?
  /// The person's link for inviting other people to use the platform (/i/<code>), made the first time it is asked for.
  inviteCode          String?           @unique
  /// Who invited this person to the platform, and when they came.
  referredById        String?
  referredAt          DateTime?
  /// Set by the platform owner: the account cannot sign in until it is cleared.
  suspendedAt         DateTime?
  referredBy          User?             @relation("PlatformInvites", fields: [referredById], references: [id], onDelete: SetNull)
  invited             User[]            @relation("PlatformInvites")
  bonusPoints         BonusPoint[]      @relation("BonusOwner")

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  teamMemberships   TeamMember[]
  contactShares     ContactShare[]
  referralLinks     ReferralLink[]
  referralJoins     ReferralJoin[]
  projectAccess     ProjectMember[]
  savedFilters      SavedFilter[]
  assignedNodes     Node[]                   @relation("NodeAssignee")
  createdNodes      Node[]                   @relation("NodeCreator")
  comments          Comment[]
  attachments       Attachment[]
  timeEntries       TimeEntry[]
  crmActivities     CrmActivity[]
  reminders         Reminder[]
  notifications     Notification[]
  companiesOwned    Company[]
  contactsOwned     Contact[]
  dealsOwned        Deal[]
  runningTimer      RunningTimer?
  userIntegrations  UserIntegration[]
  apiTokens         ApiToken[]
  oauthGrants       OAuthGrant[]
  notificationPrefs NotificationPreference[]
  calendarLinks     CalendarLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Platform ─────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// The plan in force now: the best of `basePlan` and the time-limited Pro below. Everything that checks limits and features reads this.
  plan      Plan     @default(FREE)
  /// What is lasting: a Stripe subscription, the administrator's list or a permanent gift.
  basePlan  Plan     @default(FREE)
  /// Pro until these days, from the 14-day trial, from bonus points and from a gift with an end date.
  trialEndsAt DateTime?
  bonusUntil  DateTime?
  giftUntil   DateTime?
  region    String   @default("eu")
  createdAt DateTime @default(now())

  memberships      Membership[]
  invitations      Invitation[]
  teams            Team[]
  contactShares    ContactShare[]
  referralLinks    ReferralLink[]
  nodes            Node[]
  tags             Tag[]
  contactGroups    ContactGroup[]
  scripts          Script[]
  stageRules       StageRule[]
  networkGoals     NetworkGoal[]
  notes            Note[]
  timeEntries      TimeEntry[]
  personalGoals    PersonalGoal[]
  onboardingStates OnboardingState[]
  runningTimers    RunningTimer[]
  pipelines        Pipeline[]
  lostReasons      LostReason[]
  templates        ProjectTemplate[]
  savedFilters     SavedFilter[]
  crmActivities    CrmActivity[]
  leadForms        LeadForm[]
  integrations     Integration[]
  aiUsage          AiUsage[]
  notifications    Notification[]
  subscription     Subscription?
  userIntegrations UserIntegration[]
  apiTokens        ApiToken[]
  oauthGrants      OAuthGrant[]
  webhookEndpoints WebhookEndpoint[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  crmAccess   Boolean  @default(false) // separate flag: who may see deal amounts / CRM
  crmScope    CrmScope @default(ALL) // with crmAccess: whose people the member sees (owners and admins always see all)
  teamScope   CrmScope? // what the member's teams grant (the best of them); kept in step by the team service
  hourlyRate  Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

/// A hand-made team: a few members who may be given CRM access together. TEAM shares the members' people among them, ALL shows everything.
model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  leaderId    String?
  crmScope    CrmScope?
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  shares    ContactShare[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

/// Access to one contact, or to a whole group of contacts (its subgroups included), given to one member or to a team.
model ContactShare {
  id            String     @id @default(cuid())
  workspaceId   String
  contactId     String?
  groupId       String?
  userId        String?
  teamId        String?
  level         ShareLevel @default(VIEW)
  grantedById   String?
  createdAt     DateTime   @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?      @relation(fields: [contactId], references: [nodeId], onDelete: Cascade)
  group     ContactGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([workspaceId, teamId])
  @@index([contactId])
  @@index([groupId])
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        Role             @default(MEMBER)
  crmAccess   Boolean          @default(false)
  crmScope    CrmScope         @default(ALL)
  tokenHash   String           @unique // sha256 of the emailed token; the token itself is never stored
  status      InvitationStatus @default(PENDING)
  invitedById String
  projectIds  String[] // for GUEST / CLIENT: projects they get access to
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

model ProjectMember {
  nodeId              String
  userId              String
  visibleToClientOnly Boolean @default(false)

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([nodeId, userId])
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     NodeTag[]

  @@unique([workspaceId, name])
}

model SavedFilter {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  name        String
  criteria    Json
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Universal node ─────────────────────────

model Node {
  id                 String          @id @default(cuid())
  workspaceId        String
  parentId           String?
  rootId             String? // project this node belongs to (null on the project itself)
  type               NodeType
  title              String
  description        String?         @db.Text
  position           Float           @default(0)
  status             NodeStatus      @default(TODO)
  progress           Int             @default(0) // 0–100, enforced by CHECK in migration
  progressMode       ProgressMode    @default(MANUAL)
  health             Health          @default(GREEN)
  healthOverride     Health?
  healthOverrideNote String? // required whenever healthOverride is set (checked in service)
  startDate          DateTime?
  dueDate            DateTime?
  estimation         Decimal?        @db.Decimal(8, 2)
  estimationUnit     EstimationUnit?
  assigneeId         String?
  createdById        String
  collapsed          Boolean         @default(false)
  visibleToClient    Boolean         @default(false)
  data               Json            @default("{}") // validated by a Zod schema per NodeType
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  archivedAt         DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Node?     @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Node[]    @relation("Tree")
  assignee  User?     @relation("NodeAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("NodeCreator", fields: [createdById], references: [id])

  tags          NodeTag[]
  comments      Comment[]
  attachments   Attachment[]
  approvals     Approval[]
  timeEntries   TimeEntry[]
  linksFrom     NodeLink[]      @relation("LinkFrom")
  linksTo       NodeLink[]      @relation("LinkTo")
  projectAccess ProjectMember[]

  company       Company?
  contact       Contact?
  deal          Deal?
  statusEvents  NodeStatusEvent[]
  timers        RunningTimer[]
  calendarLinks CalendarLink[]

  @@index([workspaceId, type])
  @@index([rootId])
  @@index([parentId, position])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueDate])
}

model NodeTag {
  nodeId String
  tagId  String
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([nodeId, tagId])
}

model NodeLink {
  id         String   @id @default(cuid())
  fromNodeId String
  toNodeId   String
  kind       LinkKind
  createdAt  DateTime @default(now())

  from Node @relation("LinkFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  to   Node @relation("LinkTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, kind])
  @@index([toNodeId, kind])
}

model Comment {
  id              String   @id @default(cuid())
  nodeId          String
  authorId        String
  body            Json // Tiptap document
  mentions        String[]
  parentCommentId String?
  isAiGenerated   Boolean  @default(false)
  /**
   * Shown in the client portal. Clients' own comments are always visible to them.
   */
  visibleToClient Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  node    Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("Thread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Thread")

  @@index([nodeId, createdAt])
}

model Attachment {
  id              String   @id @default(cuid())
  nodeId          String
  fileName        String
  mime            String
  size            Int
  url             String
  uploadedById    String
  /**
   * Shown in the client portal. Files clients upload themselves are always visible to them.
   */
  visibleToClient Boolean  @default(false)
  createdAt       DateTime @default(now())

  node       Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

// No FK to Node on purpose: the audit trail must outlive the node.
model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  nodeId      String?
  actorId     String?
  action      String
  diff        Json?
  createdAt   DateTime @default(now())

  @@index([nodeId, createdAt])
  @@index([workspaceId, createdAt])
}

model TimeEntry {
  id          String   @id @default(cuid())
  /// The task the time was spent on; none for plain "I worked on this" time.
  nodeId      String?
  workspaceId String
  userId      String
  minutes     Int
  /// The day the time belongs to, in the person's own time zone.
  date        DateTime @db.Date
  billable    Boolean  @default(false)
  note        String?
  /// What the time was spent on, when there is no task.
  label       String?

  node      Node?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([workspaceId, userId, date])
  @@index([nodeId])
}

// ───────────────────────── CRM ─────────────────────────

model Company {
  nodeId         String         @id
  workspaceId    String
  domain         String? // normalised website host, for duplicate detection
  legalName      String
  website        String?
  industry       String?
  size           String?
  country        String?
  city           String?
  address        String?
  taxId          String?
  source         String?
  ownerId        String?
  lifecycleStage LifecycleStage @default(LEAD)
  customFields   Json           @default("{}")

  node  Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  contacts   Contact[]
  deals      Deal[]
  activities CrmActivity[]

  @@index([workspaceId, domain])
}

model Contact {
  nodeId          String    @id
  workspaceId     String
  phonesNorm      String[] // last 9 digits of each phone, for duplicate detection
  firstName       String
  lastName        String?
  position        String?
  emails          String[]
  phones          String[]
  messengers      Json      @default("{}") // { telegram, whatsapp, instagram }
  companyId       String?
  ownerId         String?
  birthday        DateTime? @db.Date
  consentGiven    Boolean   @default(false)
  consentAt       DateTime?
  lastContactedAt DateTime?

  // The person in a funnel (network marketing): where they are, how warm, where they came from, what is next.
  stage          PersonStage  @default(NEW)
  stageChangedAt DateTime     @default(now())
  temperature    Temperature?
  interests      String[]     @default([])
  source         String?
  /// 1 to 12: how much the person can move others, as the team rates it.
  influence      Int?
  nextStep       String?
  nextStepAt     DateTime?
  /// The letter the team uses for the kind of person ("П" or "Б"); kept as typed.
  typeTag        String?
  country        String?
  /// Whose link or invitation the person came through, until partners have cards of their own.
  sponsorName    String?
  /// The one group (or subgroup) the person is listed in, e.g. "Cold market / Gym".
  groupId        String?
  /// The partner (a contact in the Partner stage) this person's line goes up to: the sponsor tree is made of these.
  sponsorId      String?
  /// The partner who works with this person now (a partner with an account sees them as their own; one without gets a handoff card).
  heldById       String?
  /// For a partner who has an account in the workspace: that user, so a hand-over also changes the owner.
  linkedUserId   String?

  node    Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  company Company?      @relation(fields: [companyId], references: [nodeId], onDelete: SetNull)
  owner   User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  group   ContactGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sponsor Contact?      @relation("Sponsor", fields: [sponsorId], references: [nodeId], onDelete: SetNull)
  heldBy  Contact?      @relation("HeldBy", fields: [heldById], references: [nodeId], onDelete: SetNull)

  downline        Contact[]           @relation("Sponsor")
  held            Contact[]           @relation("HeldBy")
  primaryForDeals Deal[]
  activities      CrmActivity[]
  stageEvents     ContactStageEvent[]
  transfers       ContactTransfer[]
  shares          ContactShare[]

  @@index([companyId])
  @@index([workspaceId, stage])
  @@index([workspaceId, nextStepAt])
  @@index([workspaceId, groupId])
  @@index([workspaceId, sponsorId])
  @@index([workspaceId, heldById])
  @@index([emails], type: Gin)
  @@index([workspaceId])
  @@index([phonesNorm], type: Gin)
}

/// A named group of people, nested up to three levels ("Warm market" > "Colleagues" > "Old job"), to split a long list into lots that can be worked or handed over.
model ContactGroup {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  color       String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    ContactGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ContactGroup[] @relation("GroupTree")
  contacts  Contact[]
  shares    ContactShare[]

  @@index([workspaceId, parentId])
}

/// A person's dream and what it takes: written once at the start and measured against the funnel (clients and partners won, days left).
model PersonalGoal {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  dream          String    @default("")
  why            String    @default("")
  targetDate     DateTime? @db.Date
  targetClients  Int?
  targetPartners Int?
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

/// Which onboarding steps a person set aside, and whether they put the whole list away. What is done is read from their data, not stored.
model OnboardingState {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  skipped     String[] @default([])
  hidden      Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

enum NoteKind {
  NOTE
  LINK
}

/// A person's own notebook: notes and useful links, private to whoever wrote them (no one else in the workspace can read them).
model Note {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  kind        NoteKind @default(NOTE)
  title       String   @default("")
  body        String   @default("") @db.Text
  /// For a link: where it goes (http or https).
  url         String?
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, updatedAt])
}

/// A ready text for a moment in the funnel (the first message, the invitation, the follow-up), kept by the team and copied into a messenger.
model Script {
  id          String       @id @default(cuid())
  workspaceId String
  title       String
  /// The funnel stage the text is for; null = for any moment.
  stage       PersonStage?
  body        String       @db.Text
  position    Int          @default(0)
  createdById String?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, stage])
}

/// What to do next, and in how many days, when a person moves into a stage: the next step fills itself in.
model StageRule {
  id          String      @id @default(cuid())
  workspaceId String
  stage       PersonStage
  nextStep    String
  afterDays   Int         @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, stage])
}

/// A person's targets for the week (invitations, presentations, clients...), kept per workspace.
model NetworkGoal {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  goals       Json     @default("{}")
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

/// Every hand-over of a person to a partner (or back), so it is always known who passed whom to whom, and when.
model ContactTransfer {
  id            String   @id @default(cuid())
  contactNodeId String
  workspaceId   String
  fromHeldId    String?
  toHeldId      String?
  fromOwnerId   String?
  toOwnerId     String?
  note          String?
  actorId       String?
  at            DateTime @default(now())

  contact Contact @relation(fields: [contactNodeId], references: [nodeId], onDelete: Cascade)

  @@index([contactNodeId, at])
  @@index([workspaceId, at])
}

/// Every move of a person along the funnel, so the week's invitations, meetings, clients and partners can be counted from what happened.
model ContactStageEvent {
  id            String       @id @default(cuid())
  contactNodeId String
  workspaceId   String
  fromStage     PersonStage?
  toStage       PersonStage
  at            DateTime     @default(now())
  actorId       String?

  contact Contact @relation(fields: [contactNodeId], references: [nodeId], onDelete: Cascade)

  @@index([contactNodeId, at])
  @@index([workspaceId, at])
}

model Pipeline {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean @default(false)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]
  leadForms LeadForm[]
}

model PipelineStage {
  id          String  @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  probability Int     @default(0)
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, order])
}

model LostReason {
  id          String @id @default(cuid())
  workspaceId String
  name        String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@unique([workspaceId, name])
}

model Deal {
  nodeId            String    @id
  workspaceId       String
  stageEnteredAt    DateTime  @default(now()) // for "stuck in stage"
  pipelineId        String
  stageId           String
  amount            Decimal   @default(0) @db.Decimal(14, 2)
  currency          String    @default("EUR")
  expectedCloseDate DateTime?
  probability       Int?
  ownerId           String?
  companyId         String?
  primaryContactId  String?
  lostReasonId      String?
  wonAt             DateTime?
  lostAt            DateTime?
  source            String?
  nextStep          String? // empty → deal is highlighted yellow
  nextStepAt        DateTime?
  lastActivityAt    DateTime? // drives the "stagnation" heatmap

  node           Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id])
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  owner          User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  company        Company?      @relation(fields: [companyId], references: [nodeId], onDelete: SetNull)
  primaryContact Contact?      @relation(fields: [primaryContactId], references: [nodeId], onDelete: SetNull)
  lostReason     LostReason?   @relation(fields: [lostReasonId], references: [id])

  activities  CrmActivity[]
  stageEvents DealStageEvent[]

  @@index([pipelineId, stageId])
  @@index([companyId])
  @@index([workspaceId, ownerId])
}

model CrmActivity {
  id          String          @id @default(cuid())
  workspaceId String
  type        CrmActivityType
  subject     String
  body        String?         @db.Text
  dueAt       DateTime?
  /// How long a scheduled call or meeting lasts, so the calendar can draw it as a block. Null = a point in time.
  durationMin Int?
  completedAt DateTime?
  ownerId     String
  contactId   String?
  companyId   String?
  dealId      String?
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id])
  contact   Contact?  @relation(fields: [contactId], references: [nodeId], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [nodeId], onDelete: Cascade)
  deal      Deal?     @relation(fields: [dealId], references: [nodeId], onDelete: Cascade)

  @@index([workspaceId, ownerId, dueAt])
  @@index([dealId])
  @@index([contactId])
  @@index([companyId])
}

model Reminder {
  id           String          @id @default(cuid())
  userId       String
  targetNodeId String
  remindAt     DateTime
  channel      ReminderChannel @default(IN_APP)
  done         Boolean         @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([remindAt, done])
}

model ProjectTemplate {
  id          String  @id @default(cuid())
  workspaceId String?
  name        String
  structure   Json
  isBuiltIn   Boolean @default(false)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Cross-cutting (used from later phases) ─────────────────────────

model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  kind        String
  payload     Json
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dedupeKey       String?
  /// Channels (email, slack, telegram) still waiting for delivery: a small outbox drained by a background job.
  pendingChannels String[]  @default([])

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model LeadForm {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  pipelineId  String
  publicKey   String  @unique
  config      Json
  enabled     Boolean @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline  @relation(fields: [pipelineId], references: [id])
}

model Integration {
  id          String          @id @default(cuid())
  workspaceId String
  kind        IntegrationKind
  config      Json
  secretEnc   String? // AES-256-GCM, key from SECRETS_KEY
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind])
}

model AiUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String?
  feature      String
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Subscription {
  workspaceId       String    @id
  provider          String    @default("stripe")
  externalId        String?
  status            String    @default("none")
  seats             Int       @default(1)
  currentPeriodEnd  DateTime?
  stripeCustomerId  String?   @unique
  cancelAtPeriodEnd Boolean   @default(false)
  /**
   * First failed payment of the current dunning cycle; the grace period counts from here.
   */
  pastDueSince      DateTime?
  /**
   * Stripe time of the newest event applied, so an older event arriving late is ignored.
   */
  lastEventAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * Stripe events already handled (webhooks are delivered at least once).
 */
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

model ConsentRecord {
  id            String    @id @default(cuid())
  contactNodeId String
  purpose       String
  givenAt       DateTime
  source        String?
  revokedAt     DateTime?

  @@index([contactNodeId])
}

// Inbound leads (forms and webhooks): audit trail, idempotency, abuse tracing.
model LeadIngest {
  id             String   @id @default(cuid())
  workspaceId    String
  source         String // "form:<id>" | "webhook"
  idempotencyKey String?
  payload        Json
  ipHash         String?
  status         String // created | duplicate | rejected
  contactId      String?
  dealId         String?
  error          String?
  createdAt      DateTime @default(now())

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
}

// ───────────────────────── Phase 4 ─────────────────────────

// Every status change of a project node: the raw material for cumulative flow, cycle time and throughput.
model NodeStatusEvent {
  id         String      @id @default(cuid())
  nodeId     String
  projectId  String
  fromStatus NodeStatus?
  toStatus   NodeStatus
  at         DateTime    @default(now())
  actorId    String?

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([projectId, at])
  @@index([nodeId, at])
}

// Every stage change of a deal: funnel conversion and sales-cycle reports.
model DealStageEvent {
  id          String   @id @default(cuid())
  dealId      String
  workspaceId String
  pipelineId  String
  fromStageId String?
  toStageId   String
  at          DateTime @default(now())
  actorId     String?

  deal Deal @relation(fields: [dealId], references: [nodeId], onDelete: Cascade)

  @@index([pipelineId, at])
  @@index([workspaceId, at])
}

// At most one running timer per person.
model RunningTimer {
  userId      String   @id
  nodeId      String?
  workspaceId String
  label       String?
  startedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  node      Node?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// A person's own connection to an external service (Google Calendar, Telegram).
model UserIntegration {
  id          String          @id @default(cuid())
  userId      String
  workspaceId String?
  kind        IntegrationKind
  externalId  String? // Telegram chat id, Google account e-mail…
  secretEnc   String? // AES-256-GCM, key from SECRETS_KEY
  config      Json            @default("{}")
  createdAt   DateTime        @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, workspaceId])
  @@index([kind, externalId])
}

// Event node ↔ calendar event.
model CalendarLink {
  nodeId       String   @id
  userId       String
  calendarId   String
  externalId   String
  etag         String?
  lastSyncedAt DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId, externalId])
}

model NotificationPreference {
  userId      String
  workspaceId String
  kind        String
  channels    String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId, kind])
}

// ── Public API ──────────────────────────────────────────────────────────────

/**
 * Personal access token for the public API; acts as `userId` inside one workspace. Only a hash is stored.
 */
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  prefix      String
  tokenHash   String    @unique
  scope       String    @default("read") // read | write
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  /// Set for tokens issued through OAuth (Claude and other MCP clients): revoking the grant revokes them.
  grantId     String?

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant     OAuthGrant? @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([grantId])
}

/// A program that registered itself to ask for access (RFC 7591), e.g. Claude. A public client: no secret, PKCE is required.
model OAuthClient {
  id           String   @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  grants OAuthGrant[]
  codes  OAuthCode[]
}

/// One person's permission for one program to act in one workspace. Revoking it ends every token issued under it.
model OAuthGrant {
  id          String    @id @default(cuid())
  clientId    String
  userId      String
  workspaceId String
  scope       String    @default("read") // read | write
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  client        OAuthClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokens        ApiToken[]
  refreshTokens OAuthRefresh[]

  @@index([userId])
  @@index([workspaceId])
}

/// A one-time authorization code, valid for minutes and exchangeable once together with the PKCE verifier.
model OAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  workspaceId   String
  scope         String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Refresh tokens rotate: each is used once. Presenting a used one again means it leaked, and the whole grant is revoked.
model OAuthRefresh {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  grantId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}

/**
 * Responses to POSTs that carried an Idempotency-Key, replayed on retries for a day.
 */
model ApiIdempotency {
  tokenId   String
  key       String
  status    Int
  body      Json
  createdAt DateTime @default(now())

  @@id([tokenId, key])
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  secretEnc   String
  events      String[]
  enabled     Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  endpointId    String
  event         String
  payload       Json
  status        String    @default("pending") // pending | delivered | failed
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

/**
 * A request for a client to sign off on a node ("approve the design"). One pending request per node.
 */
model Approval {
  id            String    @id @default(cuid())
  nodeId        String
  requestedById String
  status        String    @default("PENDING") // PENDING | APPROVED | CHANGES_REQUESTED
  request       String?
  note          String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status])
}

/**
 * A one-time code e-mailed before a sensitive account action (export, deletion). Only a hash is stored.
 */
model AccountChallenge {
  id        String    @id @default(cuid())
  userId    String
  action    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, action])
}

/**
 * What happened to an account, kept after the account is gone. No foreign key on purpose.
 */
model AccountEvent {
  id     String   @id @default(cuid())
  userId String
  action String
  detail Json?
  at     DateTime @default(now())

  @@index([userId, at])
}

/// What a person typed when creating an account, kept until their first sign-in makes the account (then used and deleted).
model SignupIntent {
  email     String   @id
  firstName String?
  lastName  String?
  locale    String?
  /// The invitation link they came through, if any.
  refCode   String?
  /// The platform invitation link they came through, if any.
  inviteCode String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A sponsor's invitation link for one workspace: people who create an account through it land in that workspace's CRM as new leads.
model ReferralLink {
  id          String   @id @default(cuid())
  code        String   @unique
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  joins     ReferralJoin[]

  @@unique([userId, workspaceId])
}

/// Someone who created an account through an invitation link, and the person card made for them in the sponsor's CRM.
model ReferralJoin {
  id        String   @id @default(cuid())
  linkId    String
  userId    String
  contactId String?
  createdAt DateTime @default(now())

  link ReferralLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([linkId, userId])
}

/// Bonus points: +1 for each person who joins the platform through someone's link, and adjustments by the platform owner.
/// The balance is the sum; what the points can be spent on is not decided yet.
model BonusPoint {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  /// "invite" for a joined person, "adjustment" for the owner's change.
  reason    String
  /// The person who joined (for "invite"), or a note (for "adjustment").
  refUserId String?
  note      String?
  createdAt DateTime @default(now())

  user User @relation("BonusOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refUserId])
  @@index([userId])
}

/// What the platform owner did to other people's accounts and workspaces.
model AdminLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  targetUserId String?
  data         Json     @default("{}")
  at           DateTime @default(now())

  @@index([at])
  @@index([targetUserId])
}

/// One request for a sign-in e-mail. Only salted hashes, so the abuse limits work without keeping addresses.
model SignInAttempt {
  id       String   @id @default(cuid())
  ipHash   String
  mailHash String
  at       DateTime @default(now())

  @@index([at])
  @@index([ipHash, at])
  @@index([mailHash, at])
}
